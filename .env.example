# Copie para `.env` e ajuste conforme o ambiente.
# O docker compose já possui valores padrão para a maioria das variáveis;
# este arquivo serve como referência. NUNCA comite o `.env` real.

# ------------------------------------------------------------
# PostgreSQL (usado pelo serviço `db` do docker compose)
# ------------------------------------------------------------
# Usuário do banco. Padrão do compose: gado
POSTGRES_USER=gado
# Senha do banco (só letras e números). Padrão do compose: gado (apenas para desenvolvimento).
# Para trocar num banco já criado: docker compose exec db psql -U gado -c "ALTER USER gado PASSWORD 'nova'"
POSTGRES_PASSWORD=troque-esta-senha
# Nome do banco. Padrão do compose: gado
POSTGRES_DB=gado
# Porta do banco no Mac (só localhost). Use outra se já houver um Postgres local.
DB_PORT=5432

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
# URL completa de conexão (dev local). No compose ela é montada
# automaticamente apontando para o host `db`.
# Ex.: postgresql+psycopg://gado:gado@localhost:5432/gado
# DATABASE_URL=

# Diretórios persistentes (o compose usa /data, /data/photos e /data/models).
# Em dev local, os padrões são ./data, ./data/photos e ./data/models.
# DATA_DIR=
# PHOTOS_DIR=
# MODELS_DIR=

# Origens permitidas no CORS, separadas por vírgula (* em dev).
CORS_ORIGINS=*

# Mínimo de animais com peso real para liberar o primeiro treino.
MIN_ANIMALS_FOR_MODEL=30
# Fotos exigidas por sessão de pesagem (mínimo e máximo).
MIN_PHOTOS_PER_WEIGHING=3
MAX_PHOTOS_PER_WEIGHING=5
# Tamanho máximo aceito por upload de foto, em MB.
MAX_UPLOAD_MB=15

# Inclinação máxima aceita da câmera, em graus.
MAX_TILT_DEG=5
# Limiares de qualidade de imagem (blur, escuro, claro e reflexo).
BLUR_THRESHOLD=60
DARK_THRESHOLD=55
BRIGHT_THRESHOLD=215
GLARE_FRACTION_THRESHOLD=0.20

# Modo passagem: máximo de quadros enviados por animal.
MAX_FRAMES_PER_PASSAGE=8

# Fase 2: segmentação/treino com YOLO (requer INSTALL_ML=true no build).
SEGMENTATION_ENABLED=false
# Peso pré-treinado baixado na primeira execução.
YOLO_WEIGHTS=yolov8n-seg.pt
# Instala ultralytics/torch na imagem do backend (build mais pesado).
INSTALL_ML=false

# ------------------------------------------------------------
# Acesso pelo celular (usuário/senha pedidos ao abrir o app)
# OBRIGATÓRIO antes de usar o acesso remoto (perfil "remoto").
# ------------------------------------------------------------
APP_USER=gado
APP_PASSWORD=

# Link fixo via Tailscale Funnel (perfil "fixo"). Chave criada em
# https://login.tailscale.com/admin/settings/keys (usada só no 1º login).
TS_AUTHKEY=

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# Vazio = mesma origem (o nginx faz proxy de /api e /photos).
# Em `npm run dev`, use http://localhost:8000 ou http://SEU_IP:8000.
VITE_API_URL=
# Endereço do link fixo (aparece em `docker compose exec funnel tailscale funnel status`).
# Usado para manter o link aquecido. Ex.: https://gado-peso.sua-rede.ts.net
PUBLIC_URL=

# Chave extra para assinar o cookie de login (opcional, recomendado).
# Gere com: openssl rand -hex 32
SESSION_SECRET=
